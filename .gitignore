# ========================
# Dependencies
# ========================
node_modules/

# ========================
# Environment — NEVER push credentials
# ========================
.env
.env.local
.env.*

# ========================
# Backend — uploaded files
# ========================
productPanel/backend/uploads/*
!productPanel/backend/uploads/.gitkeep
productPanel/backend/uploads/csv/*
!productPanel/backend/uploads/csv/.gitkeep

# ========================
# Frontend — build output
# ========================
productPanel/frontend/dist/
productPanel/frontend/.angular/cache/
productPanel/frontend/coverage/
productPanel/frontend/tmp/
productPanel/frontend/out-tsc/
productPanel/frontend/.sass-cache/

# ========================
# IDE / Editor
# ========================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
.history/

# ========================
# OS files
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# Logs
# ========================
*.log
npm-debug.log*
yarn-error.log*
